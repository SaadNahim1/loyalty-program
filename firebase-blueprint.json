{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Represents a loyalty club member and their digital stamp card.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "memberId": { "type": "string", "maxLength": 32 },
        "memberSince": { "type": "string", "maxLength": 32 },
        "currentStamps": { "type": "number" },
        "completedCardsCount": { "type": "number" },
        "lifetimeStampsEarned": { "type": "number" },
        "lastStampedDate": { "type": "string", "maxLength": 16 },
        "lastScanTimestamp": { "type": "number" },
        "rewards": { "type": "array" },
        "history": { "type": "array" }
      },
      "required": [
        "id",
        "name",
        "phone",
        "memberId",
        "memberSince",
        "currentStamps",
        "completedCardsCount",
        "lifetimeStampsEarned",
        "rewards",
        "history"
      ]
    },
    "DailyPass": {
      "title": "DailyPass",
      "description": "Stores the daily QR token, short manual code, and reward configuration generated by the cashier.",
      "type": "object",
      "properties": {
        "dateStr": { "type": "string", "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "qrToken": { "type": "string", "maxLength": 64 },
        "manualCode": { "type": "string", "maxLength": 24 },
        "treatTitle": { "type": "string", "maxLength": 80 },
        "treatDescription": { "type": "string", "maxLength": 160 },
        "allowMultiplePerDay": { "type": "boolean" },
        "staffPin": { "type": "string", "maxLength": 12 },
        "generatedAt": { "type": "number" }
      },
      "required": [
        "dateStr",
        "qrToken",
        "manualCode",
        "treatTitle",
        "treatDescription",
        "allowMultiplePerDay",
        "staffPin",
        "generatedAt"
      ]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "Customer" },
      "description": "Stores customer loyalty cards indexed by phone-derived ID or customer ID."
    },
    "/store_config/{configId}": {
      "schema": { "$ref": "DailyPass" },
      "description": "Stores the active daily QR pass and reward configuration."
    }
  }
}
